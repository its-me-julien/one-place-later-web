{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "one-place-later-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "oneplacelater.com", "custom_domain": true }
