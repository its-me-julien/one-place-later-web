---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'The Field Kit | One Place Later';
const description =
  'Three cameras and a small supporting kit for filming ordinary life from inside it, beside it, and all around it.';

const cameras = [
  {
    number: '01',
    name: 'Insta360 GO Ultra',
    perspective: 'Close',
    heading: 'Inside the moment.',
    description:
      'For point-of-view footage, discreet coverage and the quick shots that would disappear while a larger camera was still coming out of the bag.',
    uses: ['POV', 'Quick shots', 'Small spaces'],
    modifier: 'camera--close',
    image: '/gear/insta360-go-ultra-action-camera.webp',
    imageClass: 'camera__image--go',
    imageAlt: 'Insta360 GO Ultra action camera in black, shown from the front.',
  },
  {
    number: '02',
    name: 'Insta360 Ultra Luna',
    perspective: 'Composed',
    heading: 'Let the scene hold.',
    description:
      'The cinematic camera. Mostly on a tripod, it gives a place enough time and space for movement to happen inside the frame.',
    uses: ['Cinematic scenes', 'Tripod', 'Deliberate frames'],
    modifier: 'camera--composed',
    image: '/gear/insta360-luna-ultra-pocket-camera-gimbal-white.webp',
    imageClass: 'camera__image--luna',
    imageAlt: 'White Insta360 Ultra Luna camera with an articulated gimbal head.',
  },
  {
    number: '03',
    name: 'Insta360 X6',
    perspective: 'All around',
    heading: 'Move through it.',
    description:
      'For immersion on the go: moving with a street, a bicycle or a journey, then finding a cinematic angle that was not obvious at the time.',
    uses: ['Immersion', 'On the go', 'Unexpected angles'],
    modifier: 'camera--around',
    image: '/gear/insta360-x6-360-action-camera.webp',
    imageClass: 'camera__image--x6',
    imageAlt: 'Black Insta360 X6 360 action camera, shown upright from the front.',
  },
];

const heroKit = [
  { image: '/gear/insta360-go-ultra-action-camera.webp', className: 'gear-hero__camera--go' },
  { image: '/gear/insta360-luna-ultra-pocket-camera-gimbal-white.webp', className: 'gear-hero__camera--luna' },
  { image: '/gear/insta360-x6-360-action-camera.webp', className: 'gear-hero__camera--x6' },
];

const featuredAccessories = [
  {
    number: '01',
    name: 'GO Ultra Pivot Stand',
    purpose: 'A small, deliberate place to leave the camera.',
    image: '/gear/insta360-GO-Ultra-Pivot-Stand.webp',
    imageAlt: 'Insta360 GO Ultra Pivot Stand in black.',
    href: 'https://store.insta360.com/gb/product/go-ultra-pivot-stand?c=6168&from=accessory',
  },
  {
    number: '02',
    name: 'All-Purpose Tripod',
    purpose: 'A stable base when the frame needs to stay put.',
    image: '/gear/insta360-tripod-feet.webp',
    imageAlt: 'Black Insta360 tripod with three folded feet.',
    href: 'https://store.insta360.com/gb/product/all_purpose_tripod?c=851&from=accessory',
  },
  {
    number: '03',
    name: 'Extended 3m Selfie Stick',
    purpose: 'Height, distance and a viewpoint that does not announce itself.',
    image: '/gear/insta360-extended-3m-stick.webp',
    imageAlt: 'Black Insta360 extended 3m selfie stick.',
  },
];

const accessories = [
  {
    name: 'Mic Pro',
    purpose: 'Clean, immediate sound.',
    note: 'For voices and details that should feel as close as the picture.',
  },
  {
    name: 'ND filters',
    purpose: 'Movement, held in bright light.',
    note: 'For keeping motion controlled when the day is doing its best to flatten it.',
  },
];
---

<BaseLayout {title} {description}>
  <header class="gear-hero" aria-labelledby="gear-title">
    <figure
      class="gear-hero__kit"
      role="img"
      aria-label="The One Place Later field kit: the Insta360 GO Ultra, Ultra Luna, and X6 cameras."
    >
      <span class="gear-hero__index" aria-hidden="true">00</span>
      <span class="gear-hero__guide gear-hero__guide--horizontal" aria-hidden="true"></span>
      <span class="gear-hero__guide gear-hero__guide--vertical" aria-hidden="true"></span>
      {heroKit.map((camera) => <img class={camera.className} src={camera.image} alt="" decoding="async" />)}
    </figure>

    <div class="l-wrapper gear-hero__copy">
      <p class="gear-kicker"><span aria-hidden="true"></span>The field kit</p>
      <h1 id="gear-title">Three ways<br />of seeing.</h1>
      <p class="gear-hero__intro">
        One camera gets close. One waits. One sees everything around it. I use
        each for a different relationship with the place.
      </p>
    </div>
  </header>

  <section class="gear-intro" aria-labelledby="gear-intro-title">
    <div class="l-wrapper gear-intro__grid">
      <p class="section-label">Close <span aria-hidden="true">→</span> Composed <span aria-hidden="true">→</span> All around</p>
      <div>
        <h2 id="gear-intro-title">The perspective comes first.</h2>
        <p>
          This is not a list of specifications. It is the small set of tools I
          reach for when a moment needs a particular point of view.
        </p>
      </div>
    </div>
  </section>

  <section class="camera-sequence" aria-label="Three camera perspectives">
    <div class="l-wrapper camera-sequence__inner">
      {
        cameras.map((camera) => (
          <article class:list={['camera', camera.modifier]}>
            <figure class:list={['camera__placeholder', 'camera__image', camera.imageClass]}>
              <img src={camera.image} alt={camera.imageAlt} loading="eager" decoding="async" />
            </figure>

            <div class="camera__copy">
              <p class="camera__meta">
                <span>{camera.number}</span>
                <span>{camera.perspective}</span>
              </p>
              <h2>{camera.name}</h2>
              <p class="camera__heading">{camera.heading}</p>
              <p class="camera__description">{camera.description}</p>
              <ul aria-label={`${camera.name} uses`}>
                {camera.uses.map((use) => <li>{use}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="accessories" aria-labelledby="accessories-title">
    <div class="l-wrapper">
      <div class="accessories__heading">
        <p class="section-label">Supporting kit</p>
        <h2 id="accessories-title">Everything around the frame.</h2>
      </div>

      <div class="accessory-gallery">
        {
          featuredAccessories.map((accessory) => (
            <article class="accessory-feature">
              <figure class="accessory-feature__image">
                <img src={accessory.image} alt={accessory.imageAlt} loading="eager" decoding="async" />
              </figure>
              <div class="accessory-feature__copy">
                <p>{accessory.number}</p>
                <h3>
                  {
                    accessory.href ? (
                      <a href={accessory.href} target="_blank" rel="noopener">
                        {accessory.name} <span aria-hidden="true">↗</span>
                        <span class="u-visually-hidden"> (opens in a new tab)</span>
                      </a>
                    ) : (
                      accessory.name
                    )
                  }
                </h3>
                <p>{accessory.purpose}</p>
              </div>
            </article>
          ))
        }
      </div>

      <ol class="accessory-list">
        {
          accessories.map((accessory, index) => (
            <li>
              <span class="accessory-list__number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{accessory.name}</h3>
              <p class="accessory-list__purpose">{accessory.purpose}</p>
              <p class="accessory-list__note">{accessory.note}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="gear-cta" data-surface="dark" aria-labelledby="gear-cta-title">
    <div class="l-wrapper gear-cta__inner">
      <p class="gear-cta__label">The equipment stays behind the picture.</p>
      <h2 id="gear-cta-title">The place is still the point.</h2>
      <a href="https://www.youtube.com/@OnePlaceLater" target="_blank" rel="me noopener">
        See what the kit becomes <span aria-hidden="true">↗</span>
        <span class="u-visually-hidden"> on YouTube (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .gear-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
    isolation: isolate;
  }

  .gear-hero__kit {
    position: absolute;
    z-index: -1;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: #292925;
    animation: placeholder-in 900ms var(--ease-standard) both;
  }

  .gear-hero__kit::before {
    position: absolute;
    content: '';
  }

  .gear-hero__kit::before {
    inset: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 22%, transparent);
  }

  .gear-hero__guide {
    top: 50%;
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, var(--color-text-on-dark) 13%, transparent);
  }

  .gear-hero__guide--horizontal {
    right: var(--space-5);
    left: var(--space-5);
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: guide-draw 800ms 300ms var(--ease-standard) forwards;
  }

  .gear-hero__guide--vertical {
    top: var(--space-5);
    right: 32%;
    bottom: var(--space-5);
    width: 1px;
  }

  .gear-hero__index {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    z-index: -1;
    color: color-mix(in srgb, var(--color-text-on-dark) 8%, transparent);
    font-size: clamp(12rem, 38vw, 34rem);
    font-weight: 500;
    line-height: 0.75;
    letter-spacing: -0.08em;
    transform: translateY(-50%);
  }

  .gear-hero__camera--go,
  .gear-hero__camera--luna,
  .gear-hero__camera--x6 {
    position: absolute;
    max-width: none;
    animation: media-in 900ms var(--ease-standard) both;
  }

  .gear-hero__camera--go {
    right: clamp(-7rem, 4vw, 4rem);
    bottom: clamp(-6rem, -4vw, -1rem);
    width: min(56vw, 48rem);
    animation-delay: 120ms;
  }

  .gear-hero__camera--luna {
    right: clamp(4rem, 18vw, 19rem);
    bottom: clamp(-3rem, -2vw, 0rem);
    width: min(19vw, 18rem);
    padding: var(--space-3);
    background: var(--color-bg-soft);
    animation-delay: 240ms;
  }

  .gear-hero__camera--x6 {
    top: clamp(4rem, 10vh, 9rem);
    right: clamp(1rem, 8vw, 9rem);
    width: min(14vw, 13rem);
    padding: var(--space-3);
    background: var(--color-bg-soft);
    animation-delay: 360ms;
  }

  .gear-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
  }

  .gear-kicker,
  .section-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gear-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    animation: copy-in 500ms 260ms var(--ease-standard) both;
  }

  .gear-kicker span {
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  .gear-hero h1 {
    max-width: 8ch;
    font-size: clamp(3.75rem, 9.2vw, 8.5rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.055em;
    animation: copy-in 620ms 340ms var(--ease-standard) both;
  }

  .gear-hero__intro {
    width: 100%;
    max-width: 34rem;
    margin-top: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 78%, transparent);
    font-size: var(--text-base);
    line-height: 1.5;
    animation: copy-in 520ms 480ms var(--ease-standard) both;
  }

  .gear-intro {
    padding-block: var(--space-9);
  }

  .gear-intro__grid {
    display: grid;
    gap: var(--space-7);
  }

  .gear-intro__grid > *,
  .accessories__heading > * {
    min-width: 0;
  }

  .section-label {
    color: var(--color-text-muted);
  }

  .section-label span {
    margin-inline: 0.35em;
    color: var(--color-accent-strong);
  }

  .gear-intro h2,
  .accessories h2,
  .gear-cta h2 {
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .gear-intro h2 {
    max-width: 15ch;
  }

  .gear-intro h2 + p {
    max-width: 42rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera-sequence {
    padding-bottom: var(--space-9);
  }

  .camera-sequence__inner {
    position: relative;
  }

  .camera-sequence__inner::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-accent);
    content: '';
    transform: scaleY(0);
    transform-origin: top;
    animation: route-grow 1.2s 300ms var(--ease-standard) forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 80%;
  }

  .camera {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: 0 0 var(--space-9) var(--space-6);
  }

  .camera:last-child {
    padding-bottom: 0;
  }

  .camera::before {
    position: absolute;
    top: 0;
    left: -0.25rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .camera__placeholder {
    position: relative;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-text-muted);
  }

  .camera__placeholder {
    aspect-ratio: 4 / 5;
  }

  .camera--composed .camera__placeholder {
    aspect-ratio: 2 / 3;
    background: var(--color-bg-soft);
  }

  .camera--around .camera__placeholder {
    aspect-ratio: 1;
    background: var(--color-bg-soft);
  }

  .camera__placeholder::before,
  .camera__placeholder::after {
    position: absolute;
    content: '';
  }

  .camera__image {
    display: grid;
    place-items: center;
  }

  .camera__image::before,
  .camera__image::after {
    display: none;
  }

  .camera__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .camera__image:hover img {
    transform: scale(1.025);
  }

  .camera__image--go {
    background: #050505;
  }

  .camera__image--go img {
    object-fit: cover;
  }

  .camera__image--luna {
    background: var(--color-bg-soft);
    border: var(--border-default);
  }

  .camera__image--luna img {
    padding: clamp(1rem, 3vw, 3rem);
  }

  .camera__image--x6 {
    background: var(--color-bg-soft);
  }

  .camera--around .camera__image--x6 {
    background: var(--color-bg-soft);
    border: var(--border-default);
  }

  .camera__image--x6 img {
    object-fit: cover;
  }

  .camera__placeholder::before {
    inset: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 28%, transparent);
  }

  .camera__placeholder::after {
    top: 50%;
    left: 50%;
    width: min(32%, 8rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 30%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .camera__frame-mark {
    position: absolute;
    z-index: 1;
    left: 50%;
    width: 1px;
    height: 12%;
    background: var(--color-accent);
  }

  .camera__frame-mark--top {
    top: 0;
  }

  .camera__frame-mark--bottom {
    bottom: 0;
  }

  .camera__copy {
    align-self: center;
    max-width: 34rem;
  }

  .camera__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .camera__meta span:first-child {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: var(--color-bg);
    background: var(--color-accent-strong);
  }

  .camera h2 {
    max-width: 12ch;
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .camera__heading {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .camera__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--border-default);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .camera li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .camera li::before {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .accessories {
    padding-block: var(--space-9);
    background: var(--color-bg-soft);
  }

  .accessories__heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .accessories h2 {
    max-width: 15ch;
  }

  .accessory-gallery {
    display: grid;
    gap: var(--space-7);
  }

  .accessory-feature__image {
    position: relative;
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    background: #050505;
  }

  .accessory-feature__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .accessory-feature:hover .accessory-feature__image img {
    transform: scale(1.025);
  }

  .accessory-feature__copy {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .accessory-feature__copy > p:first-child {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .accessory-feature h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .accessory-feature h3 a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    text-decoration-color: color-mix(in srgb, currentColor 36%, transparent);
  }

  .accessory-feature h3 a > span:first-of-type {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .accessory-feature h3 a:hover > span:first-of-type,
  .accessory-feature h3 a:focus-visible > span:first-of-type {
    transform: translate(2px, -2px);
  }

  .accessory-feature__copy > p:last-child {
    max-width: 28ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .accessory-list {
    margin: var(--space-7) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-text);
    list-style: none;
  }

  .accessory-list li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-bottom: var(--border-default);
  }

  .accessory-list__number {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .accessory-list h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .accessory-list__purpose {
    font-size: var(--text-base);
  }

  .accessory-list__note {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .gear-cta {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-on-dark) 18%, transparent);
  }

  .gear-cta__inner {
    display: grid;
    min-height: min(70svh, 44rem);
    align-content: center;
    padding-block: var(--space-9);
  }

  .gear-cta__label {
    margin-bottom: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 62%, transparent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gear-cta h2 {
    max-width: 13ch;
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.95;
  }

  .gear-cta a {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-7);
    color: var(--color-text-on-dark);
    font-weight: 500;
    text-decoration-color: color-mix(in srgb, var(--color-text-on-dark) 48%, transparent);
  }

  .gear-cta a > span:first-of-type {
    color: var(--color-accent);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .gear-cta a:hover > span:first-of-type,
  .gear-cta a:focus-visible > span:first-of-type {
    transform: translate(3px, -3px);
  }

  .u-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes placeholder-in {
    from {
      opacity: 0;
      transform: scale(1.025);
    }
  }

  @keyframes guide-draw {
    to {
      transform: scaleX(1);
    }
  }

