---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'The Field Kit | One Place Later';
const description =
  'Three cameras and a small supporting kit we use to film ordinary life from inside it, beside it, and all around it.';

const cameras = [
  {
    number: '01',
    name: 'Insta360 GO Ultra',
    perspective: 'Close',
    heading: 'Inside the moment.',
    description:
      'We use it for point-of-view footage, discreet coverage and the quick shots that would disappear while a larger camera was still coming out of the bag.',
    uses: ['POV', 'Quick shots', 'Small spaces'],
    modifier: 'camera--close',
    image: '/gear/insta360-ultra-go-image.png',
    imageClass: 'camera__image--go',
    imageAlt: 'Insta360 GO Ultra camera and Action Pod, shown together in black.',
  },
  {
    number: '02',
    name: 'Insta360 Ultra Luna',
    perspective: 'Composed',
    heading: 'Let the scene hold.',
    description:
      'This is our cinematic camera. Mostly on a tripod, it gives a place enough time and space for movement to happen inside the frame.',
    uses: ['Cinematic scenes', 'Tripod', 'Deliberate frames'],
    modifier: 'camera--composed',
    image: '/gear/insta360-luna-ultra-pocket-camera-gimbal-white-transparent.png',
    imageClass: 'camera__image--luna',
    imageAlt: 'White Insta360 Ultra Luna camera with an articulated gimbal head.',
  },
  {
    number: '03',
    name: 'Insta360 X6',
    perspective: 'All around',
    heading: 'Move through it.',
    description:
      'We take it on the go: moving with a street, a bicycle or a journey, then finding a cinematic angle that was not obvious at the time.',
    uses: ['Immersion', 'On the go', 'Unexpected angles'],
    modifier: 'camera--around',
    image: '/gear/insta360-x6-360-action-camera-nobg.png',
    imageClass: 'camera__image--x6',
    imageAlt: 'Black Insta360 X6 360 action camera, shown upright from the front.',
  },
];

const featuredAccessories = [
  {
    number: '01',
    name: 'GO Ultra Pivot Stand',
    purpose: 'A small, deliberate place to leave the camera.',
    image: '/gear/insta360-GO-Ultra-Pivot-Stand.webp',
    imageAlt: 'Insta360 GO Ultra Pivot Stand in black.',
  },
  {
    number: '02',
    name: 'All-Purpose Tripod',
    purpose: 'A stable base when the frame needs to stay put.',
    image: '/gear/insta360-tripod-feet.webp',
    imageAlt: 'Black Insta360 tripod with three folded feet.',
  },
  {
    number: '03',
    name: 'Extended 3m Selfie Stick',
    purpose: 'Height, distance and a viewpoint that does not announce itself.',
    image: '/gear/insta360-extended-3m-stick.webp',
    imageAlt: 'Black Insta360 extended 3m selfie stick.',
  },
];

const ndKits = [
  {
    camera: 'GO Ultra',
    name: 'GO Ultra ND Filter Set',
    image: '/gear/go-ultra-insta360-nd-filter.png',
    imageAlt: 'Insta360 GO Ultra camera with three ND filters in front.',
    detail: 'ND8 · ND16 · ND32',
    purpose: 'For cinematic motion blur, richer colour and a calmer exposure in changing light.',
  },
  {
    camera: 'X6',
    name: 'X6 ND Filter Kit',
    image: '/gear/x6-insta360-nd-filter.png',
    imageAlt: 'Insta360 X6 ND64 filter viewed from the side.',
    detail: 'ND16 · ND32 · ND64',
    purpose: 'For holding daylight exposure when the camera is moving with the scene.',
  },
  {
    camera: 'Ultra Luna',
    name: 'NiSi Professional Kit',
    image: '/gear/nisi-insta360-luna-ultra-nd-cpl-vnd.png',
    imageAlt: 'NiSi filter kit for Insta360 Ultra Luna with CPL, VND, and Black Mist filters.',
    detail: 'CPL · VND 1–5 stops · Black Mist',
    purpose: 'For controlling reflections and exposure, then softening contrast when the light asks for it.',
  },
];
---

<BaseLayout {title} {description}>
  <header class="gear-hero" aria-labelledby="gear-title">
    <figure
      class="gear-hero__kit"
      role="img"
      aria-label="The Insta360 GO Ultra camera from the One Place Later field kit."
    >
      <span class="gear-hero__index" aria-hidden="true">00</span>
      <span class="gear-hero__guide gear-hero__guide--horizontal" aria-hidden="true"></span>
      <span class="gear-hero__guide gear-hero__guide--vertical" aria-hidden="true"></span>
      <img class="gear-hero__camera--go" src="/gear/insta360-go-ultra-action-camera.webp" alt="" decoding="async" />
    </figure>

    <div class="l-wrapper gear-hero__copy">
      <p class="gear-kicker"><span aria-hidden="true"></span>The field kit</p>
      <h1 id="gear-title">Three ways<br />of seeing.</h1>
      <p class="gear-hero__intro">
        One camera gets close. One waits. One sees everything around it. We use
        each for a different relationship with the place.
      </p>
    </div>
  </header>

  <section class="gear-intro" aria-labelledby="gear-intro-title">
    <div class="l-wrapper gear-intro__grid">
      <p class="section-label">Close <span aria-hidden="true">→</span> Composed <span aria-hidden="true">→</span> All around</p>
      <div>
        <h2 id="gear-intro-title">The perspective comes first.</h2>
        <p>
          This is not a list of specifications. It is the small set of tools I
          reach for when a moment needs a particular point of view.
        </p>
      </div>
    </div>
  </section>

  <section class="camera-sequence" aria-label="Three camera perspectives">
    <div class="l-wrapper camera-sequence__inner">
      {
        cameras.map((camera) => (
          <article class:list={['camera', camera.modifier]}>
            <figure class:list={['camera__placeholder', 'camera__image', camera.imageClass]}>
              <img src={camera.image} alt={camera.imageAlt} loading="eager" decoding="async" />
            </figure>

            <div class="camera__copy">
              <p class="camera__meta">
                <span>{camera.number}</span>
                <span>{camera.perspective}</span>
              </p>
              <h2>{camera.name}</h2>
              <p class="camera__heading">{camera.heading}</p>
              <p class="camera__description">{camera.description}</p>
              <ul aria-label={`${camera.name} uses`}>
                {camera.uses.map((use) => <li>{use}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="sound" aria-labelledby="sound-title">
    <div class="l-wrapper sound__inner">
      <div class="sound__copy">
        <p class="section-label">Sound</p>
        <h2 id="sound-title">Mic Pro</h2>
        <p class="sound__statement">Clean, immediate sound.</p>
        <p class="sound__description">
          For voices and details that should feel as close as the picture.
        </p>
      </div>

      <figure class="sound__visual">
        <div class="sound__levels" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <img
          src="/gear/insta360-sound-mic-pro.png"
          alt="Insta360 Mic Pro charging case, transmitter, and two wireless microphones."
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="accessories" aria-labelledby="accessories-title">
    <div class="l-wrapper">
      <div class="accessories__heading">
        <p class="section-label">Supporting kit</p>
        <h2 id="accessories-title">Everything around the frame.</h2>
      </div>

      <div class="accessory-gallery">
        {
          featuredAccessories.map((accessory) => (
            <article class:list={['accessory-feature', `accessory-feature--${accessory.number}`]}>
              <figure class="accessory-feature__image">
                <img src={accessory.image} alt={accessory.imageAlt} loading="eager" decoding="async" />
              </figure>
              <div class="accessory-feature__copy">
                <p>{accessory.number}</p>
                <h3>{accessory.name}</h3>
                <p>{accessory.purpose}</p>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </section>

  <section class="filters" aria-labelledby="filters-title">
    <div class="l-wrapper">
      <div class="filters__heading">
        <p class="section-label">Light control</p>
        <div>
          <h2 id="filters-title">Keep the movement.</h2>
          <p>
            We film at 4K, 30 frames per second, then use the right filter to
            let the light move through the frame with a little more calm.
          </p>
        </div>
      </div>

      <ol class="filter-kits">
        {
          ndKits.map((kit, index) => (
            <li class:list={['filter-kit', `filter-kit--${index + 1}`]}>
              <figure class="filter-kit__image">
                <img src={kit.image} alt={kit.imageAlt} loading="eager" decoding="async" />
              </figure>
              <p class="filter-kit__camera">{kit.camera}</p>
              <h3>{kit.name}</h3>
              <p class="filter-kit__set">{kit.detail}</p>
              <p class="filter-kit__purpose">{kit.purpose}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="gear-cta" data-surface="dark" aria-labelledby="gear-cta-title">
    <div class="l-wrapper gear-cta__inner">
      <p class="gear-cta__label">Built for the way we film.</p>
      <h2 id="gear-cta-title">Small enough to bring.</h2>
      <p class="gear-cta__copy">
        We choose lighter, less intrusive equipment for filming on the go—easy
        to bring into most situations, and ready when something happens.
      </p>
      <a href="https://www.youtube.com/@OnePlaceLater" target="_blank" rel="me noopener">
        See the kit in motion <span aria-hidden="true">↗</span>
        <span class="u-visually-hidden"> on YouTube (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .gear-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
    isolation: isolate;
  }

  .gear-hero__kit {
    position: absolute;
    z-index: -1;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: #292925;
    animation: placeholder-in 900ms var(--ease-standard) both;
  }

  .gear-hero__kit::before {
    position: absolute;
    content: '';
  }

  .gear-hero__kit::before {
    inset: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 22%, transparent);
  }

  .gear-hero__guide {
    top: 50%;
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, var(--color-text-on-dark) 13%, transparent);
  }

  .gear-hero__guide--horizontal {
    right: var(--space-5);
    left: var(--space-5);
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: guide-draw 800ms 300ms var(--ease-standard) forwards;
  }

  .gear-hero__guide--vertical {
    top: var(--space-5);
    right: 32%;
    bottom: var(--space-5);
    width: 1px;
  }

  .gear-hero__index {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    z-index: -1;
    color: color-mix(in srgb, var(--color-text-on-dark) 8%, transparent);
    font-size: clamp(12rem, 38vw, 34rem);
    font-weight: 500;
    line-height: 0.75;
    letter-spacing: -0.08em;
    transform: translateY(-50%);
  }

  .gear-hero__camera--go {
    position: absolute;
    max-width: none;
    animation: media-in 900ms var(--ease-standard) both;
  }

  .gear-hero__camera--go {
    right: clamp(-7rem, 4vw, 4rem);
    bottom: clamp(-6rem, -4vw, -1rem);
    width: min(56vw, 48rem);
    animation-delay: 120ms;
  }

  .gear-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
  }

  .gear-kicker,
  .section-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gear-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    animation: copy-in 500ms 260ms var(--ease-standard) both;
  }

  .gear-kicker span {
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  .gear-hero h1 {
    max-width: 8ch;
    font-size: clamp(3.75rem, 9.2vw, 8.5rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.055em;
    animation: copy-in 620ms 340ms var(--ease-standard) both;
  }

  .gear-hero__intro {
    width: 100%;
    max-width: 34rem;
    margin-top: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 78%, transparent);
    font-size: var(--text-base);
    line-height: 1.5;
    animation: copy-in 520ms 480ms var(--ease-standard) both;
  }

  .gear-intro {
    padding-block: var(--space-9);
  }

  .gear-intro__grid {
    display: grid;
    gap: var(--space-7);
  }

  .gear-intro__grid > *,
  .accessories__heading > * {
    min-width: 0;
  }

  .section-label {
    color: var(--color-text-muted);
  }

  .section-label span {
    margin-inline: 0.35em;
    color: var(--color-accent-strong);
  }

  .gear-intro h2,
  .accessories h2,
  .gear-cta h2 {
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .gear-intro h2 {
    max-width: 15ch;
  }

  .gear-intro h2 + p {
    max-width: 42rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera-sequence {
    padding-bottom: var(--space-9);
  }

  .camera-sequence__inner {
    position: relative;
  }

  .camera-sequence__inner::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-accent);
    content: '';
    transform: scaleY(0);
    transform-origin: top;
    animation: route-grow 1.2s 300ms var(--ease-standard) forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 80%;
  }

  .camera {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: 0 0 var(--space-9) var(--space-6);
  }

  .camera:last-child {
    padding-bottom: 0;
  }

  .camera::before {
    position: absolute;
    top: 0;
    left: -0.25rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .camera__placeholder {
    position: relative;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: transparent;
  }

  .camera__placeholder {
    aspect-ratio: 4 / 5;
  }

  .camera--composed .camera__placeholder {
    aspect-ratio: 2 / 3;
  }

  .camera--around .camera__placeholder {
    aspect-ratio: 1;
  }

  .camera__placeholder::before,
  .camera__placeholder::after {
    position: absolute;
    content: '';
  }

  .camera__image {
    display: grid;
    place-items: center;
  }

  .camera__image::before,
  .camera__image::after {
    display: none;
  }

  .camera__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .camera__image:hover img {
    transform: scale(1.025);
  }

  .camera__image--go img {
    padding: clamp(1rem, 3vw, 3rem);
  }

  .camera__image--luna img {
    padding: clamp(1rem, 3vw, 3rem);
  }

  .camera__image--x6 img {
    padding: clamp(1rem, 3vw, 3rem);
  }

  .camera__placeholder::before {
    inset: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 28%, transparent);
  }

  .camera__placeholder::after {
    top: 50%;
    left: 50%;
    width: min(32%, 8rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 30%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .camera__frame-mark {
    position: absolute;
    z-index: 1;
    left: 50%;
    width: 1px;
    height: 12%;
    background: var(--color-accent);
  }

  .camera__frame-mark--top {
    top: 0;
  }

  .camera__frame-mark--bottom {
    bottom: 0;
  }

  .camera__copy {
    align-self: center;
    max-width: 34rem;
  }

  .camera__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .camera__meta span:first-child {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: var(--color-bg);
    background: var(--color-accent-strong);
  }

  .camera h2 {
    max-width: 12ch;
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .camera__heading {
    margin-top: var(--space-5);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .camera__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--border-default);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .camera li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .camera li::before {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .sound {
    overflow: hidden;
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .sound__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .sound__copy {
    max-width: 28rem;
  }

  .sound h2 {
    margin-top: var(--space-5);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .sound__statement {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .sound__description {
    max-width: 30ch;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .sound__visual {
    position: relative;
    min-height: clamp(19rem, 42vw, 34rem);
    margin: 0;
  }

  .sound__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    animation: media-in 800ms 160ms var(--ease-standard) both;
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .sound__visual:hover img {
    transform: scale(1.025);
  }

  .sound__levels {
    position: absolute;
    z-index: 1;
    top: 12%;
    left: 0;
    display: grid;
    gap: var(--space-3);
  }

  .sound__levels span {
    display: block;
    width: clamp(2.5rem, 5vw, 5rem);
    height: 1px;
    background: var(--color-accent-strong);
  }

  .sound__levels span:nth-child(2) {
    width: clamp(4rem, 9vw, 8rem);
  }

  .sound__levels span:nth-child(3) {
    width: clamp(1.5rem, 3vw, 3rem);
  }

  .accessories {
    padding-block: var(--space-9);
    background: var(--color-bg-soft);
  }

  .accessories__heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .accessories h2 {
    max-width: 15ch;
  }

  .accessory-gallery {
    display: grid;
    gap: var(--space-7);
  }

  .accessory-feature__image {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    background: transparent;
  }

  .accessory-feature__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    padding: var(--space-4);
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .accessory-feature--03 .accessory-feature__image img {
    padding-block: 0;
  }

  .accessory-feature:hover .accessory-feature__image img {
    transform: scale(1.025);
  }

  .accessory-feature__copy {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  .accessory-feature__copy > p:first-child {
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .accessory-feature h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .accessory-feature h3 a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    text-decoration-color: color-mix(in srgb, currentColor 36%, transparent);
  }

  .accessory-feature h3 a > span:first-of-type {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .accessory-feature h3 a:hover > span:first-of-type,
  .accessory-feature h3 a:focus-visible > span:first-of-type {
    transform: translate(2px, -2px);
  }

  .accessory-feature__copy > p:last-child {
    max-width: 28ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .filters {
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .filters__heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .filters h2 {
    max-width: 11ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .filters__heading div > p {
    max-width: 38rem;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

