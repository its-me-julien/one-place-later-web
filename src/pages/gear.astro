---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import gearSocial from '../assets/gear/gear-social.png';
import goNdFilters from '../assets/gear/go-ultra-insta360-nd-filter.png';
import goPivotStand from '../assets/gear/insta360-GO-Ultra-Pivot-Stand.webp';
import extendedStick from '../assets/gear/insta360-extended-3m-stick.webp';
import goHeroCamera from '../assets/gear/insta360-go-ultra-action-camera.webp';
import lunaCamera from '../assets/gear/insta360-luna-ultra-pocket-camera-gimbal-white-transparent.png';
import micPro from '../assets/gear/insta360-sound-mic-pro.png';
import tripodFeet from '../assets/gear/insta360-tripod-feet.webp';
import goCamera from '../assets/gear/insta360-ultra-go-image.png';
import x6Camera from '../assets/gear/insta360-x6-360-action-camera-nobg.png';
import lunaNdFilters from '../assets/gear/nisi-insta360-luna-ultra-nd-cpl-vnd.png';
import x6NdFilters from '../assets/gear/x6-insta360-nd-filter.png';

const title = 'The Field Kit | One Place Later';
const description =
  'The small camera and sound kit we use to film ordinary life in motion—from close POV to composed frames and immersive routes.';

interface FieldStill {
  image: ImageMetadata;
  alt: string;
  position?: string;
}

interface Camera {
  number: string;
  name: string;
  perspective: string;
  heading: string;
  description: string;
  uses: string[];
  modifier: string;
  image: ImageMetadata;
  imageClass: string;
  imageAlt: string;
  fieldStill?: FieldStill;
}

const cameras: Camera[] = [
  {
    number: '01',
    name: 'Insta360 GO Ultra',
    perspective: 'Close',
    heading: 'Inside the moment.',
    description:
      'We use it for unusual views from inside the moment: close behaviour, discreet coverage and quick details.',
    uses: ['POV', 'Quick details', 'Small spaces'],
    modifier: 'camera--close',
    image: goCamera,
    imageClass: 'camera__visual--go',
    imageAlt: 'Insta360 GO Ultra camera shown in black.',
  },
  {
    number: '02',
    name: 'Insta360 Ultra Luna',
    perspective: 'Composed',
    heading: 'We hold the frame.',
    description:
      'We use it for deliberate compositions where movement can happen inside a frame that stays still.',
    uses: ['Tripod scenes', 'Deliberate frames', 'Movement within'],
    modifier: 'camera--composed',
    image: lunaCamera,
    imageClass: 'camera__visual--luna',
    imageAlt: 'White Insta360 Ultra Luna camera with an articulated gimbal head.',
  },
  {
    number: '03',
    name: 'Insta360 X6',
    perspective: 'All around',
    heading: 'Move through it.',
    description:
      'We capture everything while we move, place ourselves inside the environment, and choose the frame in the edit.',
    uses: ['Immersion', 'Moving routes', 'Selective reframing'],
    modifier: 'camera--around',
    image: x6Camera,
    imageClass: 'camera__visual--x6',
    imageAlt: 'Black Insta360 X6 360 action camera, shown upright from the front.',
  },
];

const featuredAccessories = [
  {
    number: '01',
    name: 'GO Ultra Pivot Stand',
    purpose: 'A small, seriously sticky place to leave the camera.',
    image: goPivotStand,
    imageAlt: 'Insta360 GO Ultra Pivot Stand in black.',
  },
  {
    number: '02',
    name: 'All-Purpose Tripod',
    purpose: 'A stable base for the selfie stick when the frame needs to stay put.',
    image: tripodFeet,
    imageAlt: 'Black Insta360 tripod with three folded feet.',
  },
  {
    number: '03',
    name: 'Extended 3m Selfie Stick',
    purpose: 'Bigger and heavier than the rest, but indispensable for high viewpoints and perspectives we cannot reach by hand.',
    image: extendedStick,
    imageAlt: 'Black Insta360 extended 3m selfie stick.',
  },
];

const ndKits = [
  {
    camera: 'GO Ultra',
    name: 'GO Ultra ND Filter Set',
    image: goNdFilters,
    imageAlt: 'Insta360 GO Ultra camera with three ND filters in front.',
    detail: 'ND8 · ND16 · ND32',
  },
  {
    camera: 'X6',
    name: 'X6 ND Filter Kit',
    image: x6NdFilters,
    imageAlt: 'Insta360 X6 ND64 filter viewed from the side.',
    detail: 'ND16 · ND32 · ND64',
  },
  {
    camera: 'Ultra Luna',
    name: 'NiSi Professional Kit',
    image: lunaNdFilters,
    imageAlt: 'NiSi filter kit for Insta360 Ultra Luna with CPL, VND, and Black Mist filters.',
    detail: 'CPL · VND 1–5 stops · Black Mist',
  },
];
---

<BaseLayout
  {title}
  {description}
  image={gearSocial.src}
  imageAlt="Insta360 GO Ultra beside the words Three ways of seeing on the One Place Later field-kit poster."
>
  <header class="gear-hero" aria-labelledby="gear-title">
    <figure
      class="gear-hero__kit"
      role="img"
      aria-label="The Insta360 GO Ultra camera from the One Place Later field kit."
    >
      <span class="gear-hero__index" aria-hidden="true">00</span>
      <span class="gear-hero__guide gear-hero__guide--horizontal" aria-hidden="true"></span>
      <span class="gear-hero__guide gear-hero__guide--vertical" aria-hidden="true"></span>
      <div class="gear-hero__camera">
        <Picture
          src={goHeroCamera}
          formats={['avif', 'webp']}
          widths={[480, 768, 960, 1200]}
          sizes="(max-width: 30rem) 31rem, (max-width: 72rem) 56vw, 48rem"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </figure>

    <div class="l-wrapper gear-hero__copy">
      <p class="gear-kicker"><span aria-hidden="true"></span>The field kit</p>
      <h1 id="gear-title">Three ways<br />of seeing.</h1>
      <p class="gear-hero__intro">
        One camera gets close. One waits. One sees the whole scene. We choose
        each for the relationship it creates with the place.
      </p>
    </div>
  </header>

  <section class="gear-intro" aria-labelledby="gear-intro-title">
    <div class="l-wrapper gear-intro__grid">
      <p class="section-label">Close <span aria-hidden="true">→</span> Composed <span aria-hidden="true">→</span> All around</p>
      <div>
        <h2 id="gear-intro-title">We choose the perspective first.</h2>
        <p>
          Then we choose the most practical camera for telling it honestly. We
          keep the kit light so we can move quickly, stay less intrusive, and
          keep our attention on what is happening.
        </p>
      </div>
    </div>
  </section>

  <section class="camera-sequence" aria-label="Three camera perspectives">
    <div class="l-wrapper camera-sequence__inner">
      {
        cameras.map((camera) => (
          <article class:list={['camera', camera.modifier]}>
            <figure
              class:list={[
                'camera__visual',
                camera.imageClass,
                { 'camera__visual--with-still': Boolean(camera.fieldStill) },
              ]}
              style={`--field-position: ${camera.fieldStill?.position ?? 'center'}`}
            >
              {camera.fieldStill && (
                <div class="camera__field-still">
                  <Picture
                    src={camera.fieldStill.image}
                    formats={['avif', 'webp']}
                    widths={[480, 768, 960, 1200]}
                    sizes="(max-width: 47.99rem) calc(100vw - 3rem), 50vw"
                    alt={camera.fieldStill.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="camera__product">
                <Picture
                  src={camera.image}
                  formats={['avif', 'webp']}
                  widths={[480, 768, 960]}
                  sizes="(max-width: 47.99rem) calc(100vw - 4rem), 46vw"
                  alt={camera.fieldStill ? '' : camera.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </figure>

            <div class="camera__copy">
              <p class="camera__meta">
                <span>{camera.number}</span>
                <span>{camera.perspective}</span>
                <span>{camera.name}</span>
              </p>
              <h2>{camera.heading}</h2>
              <p class="camera__description">{camera.description}</p>
              <ul aria-label={`${camera.name} uses`}>
                {camera.uses.map((use) => <li>{use}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="sound" aria-labelledby="sound-title">
    <div class="l-wrapper sound__inner">
      <div class="sound__copy">
        <p class="section-label">Sound</p>
        <h2 id="sound-title">We listen to the place.</h2>
        <p class="sound__product">Mic Pro</p>
        <p class="sound__description">
          We use the Mic Pro to keep our voices clear without losing the place
          around us: wind, street sound and the small details that pull the
          viewer in.
        </p>
      </div>

      <figure class="sound__visual">
        <div class="sound__levels" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <Picture
          src={micPro}
          formats={['avif', 'webp']}
          widths={[480, 768, 960]}
          sizes="(max-width: 47.99rem) calc(100vw - 3rem), 52vw"
          alt="Insta360 Mic Pro charging case, transmitter, and two wireless microphones."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="supporting" aria-labelledby="supporting-title">
    <div class="l-wrapper">
      <header class="supporting__heading">
        <p class="section-label">Supporting the shot</p>
        <div>
          <h2 id="supporting-title">We place the camera<br />in the scene.</h2>
          <p>
            Small supports let us film from within the space, above it or while
            moving through it.
          </p>
        </div>
      </header>

      <div class="support-rail">
        {
          featuredAccessories.map((accessory) => (
            <article class:list={['support-item', `support-item--${accessory.number}`]}>
              <figure class="support-item__image">
                <Picture
                  src={accessory.image}
                  formats={['avif', 'webp']}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 47.99rem) 8rem, 30vw"
                  alt={accessory.imageAlt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="support-item__copy">
                <p>{accessory.number}</p>
                <h3>{accessory.name}</h3>
                <p>{accessory.purpose}</p>
              </div>
            </article>
          ))
        }
      </div>

      <section class="light-control" aria-labelledby="light-title">
        <header class="light-control__heading">
          <div class="light-control__copy">
            <p class="section-label">Light and motion</p>
            <h3 id="light-title">We keep motion natural.</h3>
            <p>
              At 4K and 30 frames per second, we use filters to control exposure
              without losing natural motion.
            </p>
          </div>
          <p class="light-control__setting" aria-label="4K at 30 frames per second">
            <span>4K</span><i aria-hidden="true">/</i><span>30</span>
          </p>
        </header>

        <ol class="filter-rail">
          {
            ndKits.map((kit, index) => (
              <li class:list={['filter-item', `filter-item--${index + 1}`]}>
                <figure class="filter-item__image">
                  <Picture
                    src={kit.image}
                    formats={['avif', 'webp']}
                    widths={[320, 480, 720]}
                    sizes="(max-width: 47.99rem) 8rem, 30vw"
                    alt={kit.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="filter-item__copy">
                  <p class="filter-item__camera">{kit.camera}</p>
                  <h4>{kit.name}</h4>
                  <p class="filter-item__set">{kit.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </section>

  <section class="gear-cta" data-surface="dark" aria-labelledby="gear-cta-title">
    <div class="l-wrapper gear-cta__inner">
      <p class="gear-cta__label">Why we keep the kit small</p>
      <h2 id="gear-cta-title">Less setup.<br />More time filming.</h2>
      <p class="gear-cta__copy">
        We choose small, light tools so we can move quickly, film more, and
        stay present in the place.
      </p>
      <a href="https://www.youtube.com/@OnePlaceLater" target="_blank" rel="me noopener">
        See the kit in motion <span aria-hidden="true">↗</span>
        <span class="u-visually-hidden"> on YouTube (opens in a new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .gear-hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
    isolation: isolate;
  }

  .gear-hero__kit {
    position: absolute;
    z-index: -1;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: #292925;
  }

  .gear-hero__kit::before {
    position: absolute;
    z-index: 2;
    inset: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--color-text-on-dark) 22%, transparent);
    content: '';
    pointer-events: none;
  }

  .gear-hero__guide {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, var(--color-text-on-dark) 13%, transparent);
  }

  .gear-hero__guide--horizontal {
    top: 50%;
    right: var(--space-5);
    left: var(--space-5);
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: guide-draw 620ms 120ms var(--ease-standard) forwards;
  }

  .gear-hero__guide--vertical {
    top: var(--space-5);
    right: 32%;
    bottom: var(--space-5);
    width: 1px;
  }

  .gear-hero__index {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    z-index: -1;
    color: color-mix(in srgb, var(--color-text-on-dark) 8%, transparent);
    font-size: clamp(12rem, 38vw, 34rem);
    font-weight: 500;
    line-height: 0.75;
    letter-spacing: -0.08em;
    transform: translateY(-50%);
  }

  .gear-hero__camera {
    position: absolute;
    right: clamp(-7rem, 4vw, 4rem);
    bottom: clamp(-6rem, -4vw, -1rem);
    width: min(56vw, 48rem);
    animation: media-in 620ms 80ms var(--ease-standard) both;
  }

  .gear-hero__camera picture,
  .gear-hero__camera img {
    width: 100%;
    height: auto;
  }

  .gear-hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
  }

  .gear-kicker,
  .section-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .gear-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    animation: copy-in 420ms 40ms var(--ease-standard) both;
  }

  .gear-kicker span {
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  .gear-hero h1 {
    max-width: 8ch;
    font-size: clamp(3.75rem, 9.2vw, 8.5rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.055em;
    animation: copy-in 480ms 80ms var(--ease-standard) both;
  }

  .gear-hero__intro {
    width: 100%;
    max-width: 34rem;
    margin-top: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 78%, transparent);
    font-size: var(--text-base);
    line-height: 1.5;
    animation: copy-in 440ms 120ms var(--ease-standard) both;
  }

  .gear-intro {
    padding-block: var(--space-9);
  }

  .gear-intro__grid,
  .supporting__heading {
    display: grid;
    gap: var(--space-7);
  }

  .gear-intro__grid > *,
  .supporting__heading > * {
    min-width: 0;
  }

  .section-label {
    color: var(--color-text-muted);
  }

  .section-label span {
    margin-inline: 0.35em;
    color: var(--color-accent-strong);
  }

  .gear-intro h2,
  .supporting h2,
  .gear-cta h2 {
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .gear-intro h2 {
    max-width: 15ch;
  }

  .gear-intro h2 + p,
  .supporting__heading h2 + p {
    max-width: 42rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera-sequence {
    padding-bottom: var(--space-9);
  }

  .camera-sequence__inner {
    position: relative;
  }

  .camera-sequence__inner::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-accent);
    content: '';
    transform: scaleY(0);
    transform-origin: top;
    animation: route-grow 1.2s 300ms var(--ease-standard) forwards;
    animation-timeline: view();
    animation-range: entry 10% cover 80%;
  }

  .camera {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: 0 0 clamp(5rem, 9vw, 8rem) var(--space-6);
  }

  .camera:last-child {
    padding-bottom: 0;
  }

  .camera::before {
    position: absolute;
    top: 0;
    left: -0.25rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .camera__visual {
    position: relative;
    min-height: clamp(20rem, 95vw, 25rem);
    margin: 0;
    overflow: hidden;
    background: transparent;
  }

  .camera__product,
  .camera__product picture,
  .camera__product img,
  .camera__field-still,
  .camera__field-still picture,
  .camera__field-still img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .camera__product img {
    object-fit: contain;
    padding: clamp(0.75rem, 3vw, 2.5rem);
  }

  .camera__field-still img {
    object-fit: cover;
    object-position: var(--field-position);
  }

  .camera__visual--with-still {
    aspect-ratio: 3 / 2;
    min-height: 0;
  }

  .camera__visual--with-still .camera__product {
    inset: auto var(--space-4) var(--space-4) auto;
    width: min(42%, 18rem);
    height: min(64%, 20rem);
  }

  .camera__visual--with-still .camera__product img {
    padding: 0;
    object-position: right bottom;
  }

  .camera__visual--luna .camera__product img {
    padding-block: 0.5rem;
  }

  .camera__visual--x6 .camera__product img {
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .camera__copy {
    align-self: center;
    max-width: 34rem;
  }

  .camera__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .camera__meta span:first-child {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    color: var(--color-bg);
    background: var(--color-accent-strong);
  }

  .camera__meta span:last-child {
    flex-basis: 100%;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .camera h2 {
    max-width: 12ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .camera__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .camera ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--border-default);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    list-style: none;
  }

  .camera li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .camera li::before {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .sound {
    overflow: hidden;
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .sound__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .sound__copy {
    max-width: 31rem;
  }

  .sound h2 {
    max-width: 10ch;
    margin-top: var(--space-5);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .sound__product {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .sound__description {
    max-width: 35ch;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .sound__visual {
    position: relative;
    min-height: clamp(19rem, 42vw, 34rem);
    margin: 0;
  }

  .sound__visual picture,
  .sound__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sound__visual img {
    object-fit: contain;
    animation: media-in 620ms 80ms var(--ease-standard) both;
  }

  .sound__levels {
    position: absolute;
    z-index: 1;
    top: 12%;
    left: 0;
    display: grid;
    gap: var(--space-3);
  }

  .sound__levels span {
    display: block;
    width: clamp(2.5rem, 5vw, 5rem);
    height: 1px;
    background: var(--color-accent-strong);
  }

  .sound__levels span:nth-child(2) {
    width: clamp(4rem, 9vw, 8rem);
  }

  .sound__levels span:nth-child(3) {
    width: clamp(1.5rem, 3vw, 3rem);
  }

  .supporting {
    padding-block: var(--space-9);
    background: var(--color-bg-soft);
  }

  .supporting__heading {
    margin-bottom: var(--space-7);
  }

  .supporting__heading h2 {
    max-width: 12ch;
  }

  .support-rail {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--border-default);
  }

  .support-item {
    display: grid;
    grid-template-columns: minmax(7rem, 38%) minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
    align-items: center;
  }

  .support-item__image {
    position: relative;
    height: 9rem;
