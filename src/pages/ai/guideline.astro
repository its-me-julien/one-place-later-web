---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../content/ai-guideline.md';

const sections = [
  ['1-project-folder-and-preflight', 'Project folder'],
  ['2-review-footage-and-maintain-the-brief', 'Review and brief'],
  ['3-approve-the-timeline-then-work-in-batches', 'Timeline and batches'],
  ['4-editing-sequence', 'Editing stages'],
  ['5-editorial-and-finishing-rules', 'Editorial rules'],
  ['6-verify-record-and-resume', 'Verify and resume'],
  ['7-references', 'References'],
];
---

<BaseLayout title={`${frontmatter.title} | One Place Later`} description={frontmatter.description} robots="noindex, nofollow">
  <article class="protocol l-wrapper">
    <header class="protocol-header">
      <p class="eyebrow">AI / Operating protocol</p>
      <h1>{frontmatter.title}</h1>
      <p class="protocol-purpose">{frontmatter.description}</p>
      <div class="protocol-meta"><p>Audience: Codex · v{frontmatter.version} · Updated {frontmatter.updated}</p><a href="/ai/guideline.md" download="one-place-later-codex-guideline.md">Download Markdown <span aria-hidden="true">↗</span></a></div>
    </header>
    <div class="protocol-shell">
      <aside class="protocol-nav">
        <nav aria-label="Codex protocol sections"><p class="eyebrow">Protocol index</p><ol>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></nav>
      </aside>
      <div class="protocol-content"><Content /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .protocol { max-width: var(--width-content); padding-block: var(--space-7); }
  .protocol-header { border-bottom: var(--border-default); padding-bottom: var(--space-6); }
  .eyebrow { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-muted); }
  h1 { margin-top: var(--space-3); font-size: var(--text-2xl); letter-spacing: -0.04em; }
  .protocol-purpose { max-width: var(--width-copy); margin-top: var(--space-4); font-size: var(--text-lg); }
  .protocol-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-5); font-size: var(--text-sm); color: var(--color-text-muted); }
  .protocol-meta a { display: inline-flex; align-items: center; min-height: 2.75rem; gap: var(--space-2); color: var(--color-text); }
  .protocol-meta span { color: var(--color-accent-strong); }
  .protocol-shell { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-7); padding-top: var(--space-6); }
  .protocol-nav nav { position: sticky; top: calc(var(--header-height) + var(--space-4)); }
  .protocol-nav ol { padding: 0; list-style: none; margin-top: var(--space-3); counter-reset: section; }
  .protocol-nav li { counter-increment: section; }
  .protocol-nav a { display: flex; gap: var(--space-3); align-items: center; min-height: 2.75rem; padding-block: var(--space-2); font-size: var(--text-sm); text-decoration: none; }
  .protocol-nav a::before { content: counter(section, decimal-leading-zero); color: var(--color-accent-strong); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .protocol-nav a:hover { text-decoration: underline; }
  .protocol-content { min-width: 0; overflow-wrap: anywhere; }
  .protocol-content :global(h2) { margin-block: var(--space-7) var(--space-5); font-size: var(--text-xl); line-height: 1.2; letter-spacing: -0.025em; scroll-margin-top: calc(var(--header-height) + var(--space-5)); }
  .protocol-content :global(h2:first-child) { margin-top: 0; }
  .protocol-content :global(h3) { margin-block: var(--space-6) var(--space-4); font-size: var(--text-lg); line-height: 1.3; }
  .protocol-content :global(p), .protocol-content :global(ul), .protocol-content :global(ol), .protocol-content :global(pre) { margin-block: var(--space-4); }
  .protocol-content :global(ul), .protocol-content :global(ol) { padding-left: 1.2em; }
  .protocol-content :global(li + li) { margin-top: var(--space-3); }
  .protocol-content :global(strong) { font-weight: 600; }
  .protocol-content :global(code) { font-size: 0.85em; }
  .protocol-content :global(pre) { padding: var(--space-4); background: var(--color-bg-soft); border: var(--border-default); border-radius: var(--radius-sm); overflow-x: auto; }
  .protocol-content :global(pre code) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .protocol-content :global(table) { width: 100%; border-collapse: collapse; font-size: var(--text-sm); table-layout: fixed; margin-block: var(--space-5); }
  .protocol-content :global(th), .protocol-content :global(td) { text-align: left; vertical-align: top; border-bottom: var(--border-default); padding: var(--space-3); }
  .protocol-content :global(th) { color: var(--color-text-muted); font-weight: 500; }
  .protocol-content :global(th:first-child), .protocol-content :global(td:first-child) { width: 24%; padding-left: 0; }
  .protocol-content :global(th:last-child), .protocol-content :global(td:last-child) { width: 30%; padding-right: 0; }
  @media (max-width: 47.999rem) {
    .protocol-shell { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .protocol-nav nav { position: static; }
    .protocol-nav ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-3); }
    .protocol-content :global(table), .protocol-content :global(tbody), .protocol-content :global(tr), .protocol-content :global(td) { display: block; width: 100%; }
    .protocol-content :global(thead) { display: none; }
    .protocol-content :global(tr) { padding-block: var(--space-4); border-bottom: var(--border-default); }
    .protocol-content :global(td) { border: 0; padding: var(--space-2) 0; }
    .protocol-content :global(td:first-child), .protocol-content :global(td:last-child) { width: 100%; }
    .protocol-content :global(td:first-child) { font-size: var(--text-base); font-weight: 600; }
    .protocol-content :global(td:nth-child(2))::before { content: 'Required work'; }
    .protocol-content :global(td:nth-child(3))::before { content: 'Exit evidence / approval'; }
    .protocol-content :global(td:nth-child(n+2))::before { display: block; color: var(--color-text-muted); font-size: var(--text-xs); margin-bottom: var(--space-1); }
  }
  @media print {
    :global(.site-header), :global(.site-footer), :global(.u-skip-link), .protocol-nav { display: none; }
    .protocol-shell { display: block; }
    .protocol { padding: 0; max-width: none; }
    .protocol-content :global(h2), .protocol-content :global(h3) { break-after: avoid; }
    .protocol-content :global(tr), .protocol-content :global(pre) { break-inside: avoid; }
  }
</style>
