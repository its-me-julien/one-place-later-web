---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-seoul-motion.png';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'One Place Later';
const description =
  'Films about ordinary life in motion, from Seoul to wherever comes next.';
const heroAlt =
  'A cyclist riding down a shaded path toward the Han River and the Seoul skyline.';
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage.src}
  imageAlt={heroAlt}
>
  <header class="hero">
    <Image
      class="hero-image"
      src={heroImage}
      alt={heroAlt}
      widths={[640, 960, 1280, 1702]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />

    <div class="l-wrapper hero-copy">
      <p class="hero-route">
        <span class="hero-route__place hero-route__origin">Gangnam</span>
        <span class="hero-route__line" aria-hidden="true">
          <svg viewBox="0 0 112 20" preserveAspectRatio="none">
            <circle class="hero-route__origin-dot" cx="6" cy="10" r="3" />
            <path
              class="hero-route__path"
              pathLength="1"
              d="M 11 12 H 40 C 49 12 50 5 59 5 H 78 C 88 5 89 12 101 12"
            />
            <circle class="hero-route__destination-dot" cx="106" cy="12" r="1.75" />
          </svg>
        </span>
        <span class="hero-route__place hero-route__destination">Han River</span>
      </p>
      <h1 aria-label="One Place Later">
        <span class="hero-title__line" aria-hidden="true">
          <span>One Place</span>
        </span>
        <span class="hero-title__line" aria-hidden="true">
          <span>Later</span>
        </span>
      </h1>
      <p class="hero-reveal hero-subtitle" lang="ko">
        <span>원 플레이스 레이터</span>
      </p>
    </div>
  </header>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="l-wrapper about-grid">
      <p class="eyebrow">From here</p>

      <div class="copy">
        <h2 id="about-title">
          Based in Seoul, I make films about ordinary life in motion: routines,
          food, quiet details, small escapes, and the occasional long way round.
        </h2>
        <p class="route-signoff">
          <span class="route-signoff__origin">Korea is home.</span>
          <span class="route-signoff__destination">
            <span class="route-signoff__arrow" aria-hidden="true">→</span>
            <span>The rest happens one place later.</span>
          </span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-text);
    isolation: isolate;
  }

  .hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% center;
    animation: hero-image-in 1600ms var(--ease-standard) both;
  }

  .hero-copy {
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
  }

  h1 {
    max-width: 10ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.045em;
  }

  .hero-copy > p {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hero-route {
    display: flex;
    align-items: center;
    gap: 0.65em;
    margin: 0 0 var(--space-4);
    color: color-mix(in srgb, var(--color-text-on-dark) 88%, transparent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .hero-route__place {
    white-space: nowrap;
  }

  .hero-route__origin {
    --route-place-offset: -4px;
    animation: route-place-in 300ms 80ms var(--ease-standard) both;
  }

  .hero-route__destination {
    --route-place-offset: 4px;
    animation: route-place-in 300ms 800ms var(--ease-standard) both;
  }

  .hero-route__line {
    width: clamp(4.5rem, 13vw, 8.5rem);
    height: 1.25rem;
    flex: 0 1 auto;
  }

  .hero-route__line svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero-route__path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-text-on-dark) 72%, transparent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: route-draw 640ms 240ms var(--ease-standard) forwards;
  }

  .hero-route__origin-dot,
  .hero-route__destination-dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  .hero-route__origin-dot {
    fill: var(--color-accent);
    animation: route-dot-in 240ms 100ms var(--ease-standard) both;
  }

  .hero-route__destination-dot {
    fill: color-mix(in srgb, var(--color-text-on-dark) 78%, transparent);
    animation: route-dot-in 220ms 820ms var(--ease-standard) both;
  }

  .hero-title__line,
  .hero-reveal {
    display: block;
    overflow: hidden;
  }

  .hero-title__line > span,
  .hero-reveal > span {
    display: block;
    animation: hero-type-in 560ms 680ms var(--ease-standard) both;
  }

  .hero-title__line:nth-child(2) > span {
    animation-delay: 760ms;
  }

  .hero-subtitle > span {
    animation-duration: 440ms;
    animation-delay: 1020ms;
  }

  .about {
    scroll-margin-top: var(--header-height);
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .about-grid {
    display: grid;
    gap: var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .copy {
    max-width: var(--width-content);
  }

  h2 {
    max-width: 30ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .route-signoff {
    display: grid;
    max-width: 45ch;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.5em;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-default);
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .route-signoff__origin {
    color: var(--color-text-muted);
  }

  .route-signoff__destination {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5em;
  }

  .route-signoff__arrow {
    color: var(--color-accent-strong);
    font-weight: 500;
  }

  @media (max-width: 47.999rem) {
    .hero-image {
      object-position: 69% center;
    }
  }

  @keyframes hero-image-in {
    from {
      opacity: 0.9;
      transform: scale(1.018);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes route-place-in {
    from {
      opacity: 0;
      transform: translateX(var(--route-place-offset));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes route-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes route-dot-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-type-in {
    from {
      opacity: 0;
      transform: translateY(105%);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .hero-route__place,
    .hero-route__origin-dot,
    .hero-route__destination-dot,
    .hero-title__line > span,
    .hero-reveal > span {
      animation: none;
    }

    .hero-route__path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (min-width: 48rem) {
    .hero-image {
      object-position: center;
    }

    .about-grid {
      grid-template-columns: minmax(9rem, 2fr) minmax(0, 8fr);
      align-items: start;
    }

    .route-signoff {
      display: flex;
    }
  }
</style>
