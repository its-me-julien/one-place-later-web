---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-seoul-motion.png';
import BaseLayout from '../layouts/BaseLayout.astro';

const youtubeUrl = 'https://www.youtube.com/@OnePlaceLater';
const title = 'One Place Later';
const description =
  'Films about ordinary life in motion, from Seoul to wherever comes next.';
const heroAlt =
  'A cyclist riding down a shaded path toward the Han River and the Seoul skyline.';
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage.src}
  imageAlt={heroAlt}
>
  <header class="hero">
    <Image
      class="hero-image"
      src={heroImage}
      alt={heroAlt}
      widths={[640, 960, 1280, 1702]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />

    <div class="l-wrapper hero-copy">
      <h1>One Place Later</h1>
      <p lang="ko">원 플레이스 레이터</p>
    </div>
  </header>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="l-wrapper about-grid">
      <p class="eyebrow">About the films <span aria-hidden="true">→</span></p>

      <div class="copy">
        <h2 id="about-title">
          Based in Seoul, I make films about ordinary life in motion: routines,
          food, night rides, small escapes, and the occasional long way round.
        </h2>
        <p>Korea is home. The rest happens one place later.</p>
        <a class="youtube-link" href={youtubeUrl} target="_blank" rel="me noopener">
          Watch on YouTube <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-text);
    isolation: isolate;
  }

  .hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% center;
    animation: hero-image-in 900ms var(--ease-standard) both;
  }

  .hero-copy {
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
    animation: hero-copy-in 700ms 120ms var(--ease-standard) both;
  }

  h1 {
    max-width: 10ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.045em;
  }

  .hero-copy p {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .about {
    scroll-margin-top: var(--header-height);
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .about-grid {
    display: grid;
    gap: var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow span {
    color: var(--color-accent-strong);
  }

  .copy {
    max-width: var(--width-content);
  }

  h2 {
    max-width: 30ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .copy > p {
    max-width: 42ch;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .youtube-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-7);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration-thickness: 1px;
  }

  .youtube-link span {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .youtube-link:hover span {
    transform: translate(3px, -3px);
  }

  @keyframes hero-image-in {
    from {
      opacity: 0.74;
      transform: scale(1.02);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 48rem) {
    .hero-image {
      object-position: center;
    }

    .about-grid {
      grid-template-columns: minmax(9rem, 2fr) minmax(0, 8fr);
      align-items: start;
    }
  }
</style>
