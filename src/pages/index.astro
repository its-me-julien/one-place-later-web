---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-seoul-motion.png';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'One Place Later';
const description =
  'Films about ordinary life in motion, from Seoul to wherever comes next.';
const heroAlt =
  'A cyclist riding down a shaded path toward the Han River and the Seoul skyline.';
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage.src}
  imageAlt={heroAlt}
>
  <header class="hero">
    <Image
      class="hero-image"
      src={heroImage}
      alt={heroAlt}
      widths={[640, 960, 1280, 1702]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />

    <div class="l-wrapper hero-copy">
      <p class="hero-route">Gangnam <span aria-hidden="true">→</span> Han River</p>
      <h1>One Place Later</h1>
      <p lang="ko">원 플레이스 레이터</p>
    </div>
  </header>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="l-wrapper about-grid">
      <p class="eyebrow">From here</p>

      <div class="copy">
        <h2 id="about-title">
          Based in Seoul, I make films about ordinary life in motion: routines,
          food, quiet details, small escapes, and the occasional long way round.
        </h2>
        <p class="route-signoff">
          <span class="route-signoff__origin">Korea is home.</span>
          <span class="route-signoff__destination">
            <span class="route-signoff__arrow" aria-hidden="true">→</span>
            <span>The rest happens one place later.</span>
          </span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    color: var(--color-text-on-dark);
    background: var(--color-text);
    isolation: isolate;
  }

  .hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% center;
    animation: hero-image-in 900ms var(--ease-standard) both;
  }

  .hero-copy {
    display: flex;
    min-height: calc(100svh - var(--header-height));
    flex-direction: column;
    justify-content: flex-end;
    padding-block: var(--space-8) var(--space-7);
    animation: hero-copy-in 700ms 120ms var(--ease-standard) both;
  }

  h1 {
    max-width: 10ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.93;
    letter-spacing: -0.045em;
  }

  .hero-copy p {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .hero-route {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0 0 var(--space-4);
    color: color-mix(in srgb, var(--color-text-on-dark) 88%, transparent);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .hero-route span {
    color: var(--color-accent);
    font-size: 1.15em;
  }

  .about {
    scroll-margin-top: var(--header-height);
    padding-block: var(--space-9);
    background: var(--color-bg);
  }

  .about-grid {
    display: grid;
    gap: var(--space-7);
  }

  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .copy {
    max-width: var(--width-content);
  }

  h2 {
    max-width: 30ch;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .route-signoff {
    display: grid;
    max-width: 45ch;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.5em;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-default);
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .route-signoff__origin {
    color: var(--color-text-muted);
  }

  .route-signoff__destination {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5em;
  }

  .route-signoff__arrow {
    color: var(--color-accent-strong);
    font-weight: 500;
  }

  @media (max-width: 47.999rem) {
    .hero-image {
      object-position: 69% center;
    }
  }

  @keyframes hero-image-in {
    from {
      opacity: 0.74;
      transform: scale(1.02);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 48rem) {
    .hero-image {
      object-position: center;
    }

    .about-grid {
      grid-template-columns: minmax(9rem, 2fr) minmax(0, 8fr);
      align-items: start;
    }

    .route-signoff {
      display: flex;
    }
  }
</style>
