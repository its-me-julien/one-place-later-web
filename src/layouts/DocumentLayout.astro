---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    version?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  robots="noindex, nofollow"
>
  <article class="guide">
    <header class="guide-header">
      <div class="l-wrapper guide-header__grid">
        <div>
          <p class="guide-kicker">Internal creative reference</p>
          <h1>Creative<br />Field Guide</h1>
        </div>

        <div class="guide-introduction">
          <p>{frontmatter.description}</p>
          <p class="guide-version">One Place Later · {frontmatter.version ?? 'v2.0'}</p>
        </div>
      </div>
    </header>

    <nav class="guide-index" aria-label="Creative field guide sections">
      <div class="l-wrapper guide-index__inner">
        <p>Move through the guide</p>
        <ol>
          <li><a href="#1-channel-identity">Identity <span aria-hidden="true">→</span></a></li>
          <li><a href="#7-the-fundamental-story-rule">Story <span aria-hidden="true">→</span></a></li>
          <li><a href="#14-core-visual-grammar">Filming <span aria-hidden="true">→</span></a></li>
          <li><a href="#19-sound-philosophy">Sound <span aria-hidden="true">→</span></a></li>
          <li><a href="#28-editing-rhythm">Editing <span aria-hidden="true">→</span></a></li>
          <li><a href="#44-titles">Publishing <span aria-hidden="true">→</span></a></li>
          <li><a href="#56-the-one-place-later-working-brief">Working brief <span aria-hidden="true">→</span></a></li>
        </ol>
      </div>
    </nav>

    <div class="l-wrapper guide-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .guide {
    background: var(--color-bg);
  }

  .guide-header {
    padding-block: var(--space-8);
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
  }

  .guide-header__grid {
    display: grid;
    gap: var(--space-7);
  }

  .guide-kicker,
  .guide-version,
  .guide-index p {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .guide-kicker {
    margin-bottom: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 70%, transparent);
  }

  h1 {
    max-width: 8ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .guide-introduction {
    display: grid;
    align-content: end;
    gap: var(--space-6);
    max-width: 32rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .guide-version {
    color: var(--color-accent);
  }

  .guide-index {
    border-bottom: var(--border-default);
  }

  .guide-index__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .guide-index p {
    color: var(--color-text-muted);
  }

  .guide-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-index a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration-color: color-mix(in srgb, currentColor 28%, transparent);
    text-underline-offset: 0.2em;
  }

  .guide-index a span {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .guide-index a:hover span,
  .guide-index a:focus-visible span {
    transform: translateX(3px);
  }

  .guide-body {
    padding-block: var(--space-8) var(--space-9);
  }

  .guide-body :global(> h2) {
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: var(--border-default);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .guide-body :global(h2[id]),
  .guide-body :global(.guide-chapter[id]) {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .guide-body :global(> h2:first-child) {
    margin-top: 0;
  }

  .guide-body :global(h3) {
    max-width: 42rem;
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .guide-body :global(h4) {
    max-width: 42rem;
    margin-top: var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .guide-body :global(p),
  .guide-body :global(ul),
  .guide-body :global(ol) {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .guide-body :global(ul),
  .guide-body :global(ol) {
    padding-left: 1.2em;
  }

  .guide-body :global(li + li) {
    margin-top: var(--space-2);
  }

  .guide-body :global(strong) {
    font-weight: 600;
  }

  .guide-body :global(blockquote) {
    max-width: 44rem;
    margin: var(--space-6) 0 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
  }

  .guide-body :global(hr) {
    max-width: 44rem;
    margin: var(--space-8) 0 0;
    border: 0;
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-chapter) {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-chapter:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .guide-body :global(.guide-chapter__header) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .guide-body :global(.guide-chapter__number),
  .guide-body :global(.guide-label) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-chapter__number) {
    padding-top: 0.35rem;
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-chapter__header h2) {
    max-width: 17ch;
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .guide-body :global(.guide-chapter__summary) {
    max-width: 32rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .guide-body :global(.guide-chapter__content) {
    min-width: 0;
  }

  .guide-body :global(.guide-nameplate) {
    padding-block: var(--space-5) var(--space-6);
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-nameplate__wordmark) {
    max-width: none;
    margin-top: var(--space-3);
    font-size: clamp(2.15rem, 9vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .guide-body :global(.guide-nameplate__wordmark span) {
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-declaration) {
    padding-block: var(--space-5) var(--space-6);
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-declaration > p:nth-child(2)) {
    max-width: 24ch;
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .guide-body :global(.guide-declaration__support) {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .guide-body :global(.guide-declaration__support p) {
    margin: 0;
    line-height: 1.5;
  }

  .guide-body :global(.guide-block) {
    padding-block: var(--space-7);
  }

  .guide-body :global(.guide-block h3),
  .guide-body :global(.guide-meaning h3) {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-lede) {
    max-width: 32ch;
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .guide-body :global(.guide-copy) {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .guide-body :global(.guide-copy p) {
    margin: 0;
  }

  .guide-body :global(.guide-principles) {
    display: grid;
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-principle) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-principle + .guide-principle) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-principle p) {
    margin-top: var(--space-4);
    line-height: 1.55;
  }

  .guide-body :global(.guide-principle .guide-label) {
    margin-top: 0;
  }

  .guide-body :global(.guide-principle__statement) {
    max-width: 18ch;
    color: var(--color-text);
    font-size: var(--text-xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .guide-body :global(.guide-principle blockquote) {
    max-width: 24ch;
    margin-top: var(--space-4);
    padding: 0;
    border: 0;
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-meaning) {
    display: grid;
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-contexts) {
    display: grid;
  }

  .guide-body :global(.guide-context) {
    padding-block: var(--space-6);
    border-bottom: var(--border-default);
  }

  .guide-body :global(.guide-context__place) {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .guide-body :global(.guide-context h3) {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-observation-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-observation-list li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .guide-body :global(.guide-observation-list li::before) {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .guide-body :global(.guide-meaning__column) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-meaning__column + .guide-meaning__column) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-place-list),
  .guide-body :global(.guide-state-list) {
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-place-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .guide-body :global(.guide-place-list li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    line-height: 1.35;
  }

  .guide-body :global(.guide-place-list li::before) {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .guide-body :global(.guide-state-list) {
    display: grid;
    gap: var(--space-2);
  }

  .guide-body :global(.guide-state-list li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding-bottom: var(--space-2);
    border-bottom: var(--border-default);
    line-height: 1.35;
  }

  .guide-body :global(.guide-state-list li:last-child) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .guide-body :global(.guide-state-list li > span:first-child) {
    color: var(--color-text-muted);
  }

  .guide-body :global(.guide-state-list li > span:nth-child(2)) {
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-state-list strong) {
    font-weight: 500;
  }

  .guide-body :global(.guide-route-examples) {
    border-bottom: var(--border-default);
  }

  .guide-body :global(.guide-route-example) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-route-example + .guide-route-example) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-route) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-route li) {
    display: inline-flex;
    align-items: center;
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  .guide-body :global(.guide-route li:not(:first-child)::before) {
    margin-inline: var(--space-2);
    color: var(--color-accent-strong);
    content: '→';
    font-weight: 400;
  }

  .guide-body :global(.guide-takeaway) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-text);
  }

  .guide-body :global(.guide-takeaway > p) {
    margin-top: var(--space-4);
  }

  .guide-body :global(.guide-takeaway .guide-label) {
    margin-top: 0;
  }

  .guide-body :global(.guide-takeaway__statement) {
    max-width: 28ch;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-takeaway__statement span) {
    display: block;
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    .guide-header__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      align-items: end;
    }

    .guide-index__inner {
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
      align-items: baseline;
    }

    .guide-body :global(> h2) {
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
      column-gap: var(--space-7);
    }

    .guide-body :global(> h2),
    .guide-body :global(> h3),
    .guide-body :global(> h4),
    .guide-body :global(> p),
    .guide-body :global(> ul),
    .guide-body :global(> ol),
    .guide-body :global(> blockquote),
    .guide-body :global(> hr) {
      margin-left: 25%;
    }

    .guide-body :global(> h2) {
      margin-left: 0;
    }

    .guide-body :global(.guide-chapter) {
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
      gap: var(--space-7);
    }

    .guide-body :global(.guide-chapter__header) {
      display: block;
    }

    .guide-body :global(.guide-chapter__number) {
      margin-bottom: var(--space-5);
      padding-top: 0;
    }

    .guide-body :global(.guide-principles),
    .guide-body :global(.guide-meaning),
    .guide-body :global(.guide-contexts) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .guide-body :global(.guide-principle),
    .guide-body :global(.guide-meaning__column),
    .guide-body :global(.guide-context) {
      padding-right: var(--space-6);
    }

    .guide-body :global(.guide-principle + .guide-principle),
    .guide-body :global(.guide-meaning__column + .guide-meaning__column),
    .guide-body :global(.guide-context + .guide-context) {
      padding-right: 0;
      padding-left: var(--space-6);
      border-top: 0;
      border-left: var(--border-default);
    }

    .guide-body :global(.guide-declaration--difference) {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.65fr);
      column-gap: var(--space-7);
    }

    .guide-body :global(.guide-declaration--difference .guide-label) {
      grid-column: 1 / -1;
    }

    .guide-body :global(.guide-declaration__support) {
      align-content: end;
      margin-top: var(--space-4);
    }
  }
</style>
