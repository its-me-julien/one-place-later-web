---
import BaseLayout from './BaseLayout.astro';
import {
  guideBasePath,
  guideChapterPath,
  guideChapters,
  type GuideChapter,
} from '../data/guideChapters';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    version?: string;
  };
  chapter?: GuideChapter;
}

const { frontmatter, chapter } = Astro.props;
const chapterIndex = chapter
  ? guideChapters.findIndex((item) => item.slug === chapter.slug)
  : -1;
const previousChapter = chapterIndex > 0 ? guideChapters[chapterIndex - 1] : undefined;
const nextChapter = chapterIndex >= 0 && chapterIndex < guideChapters.length - 1
  ? guideChapters[chapterIndex + 1]
  : undefined;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  robots="noindex, nofollow"
>
  <article class="guide">
    <header class:list={['guide-header', { 'guide-header--chapter': chapter }]}>
      <div class="l-wrapper guide-header__grid">
        <div>
          <p class="guide-kicker">
            {chapter ? `Creative Field Guide · Chapter ${chapterIndex + 1} of ${guideChapters.length}` : 'Internal creative reference'}
          </p>
          <h1>{chapter ? chapter.title : <Fragment>Creative<br />Field Guide</Fragment>}</h1>
        </div>

        <div class="guide-introduction">
          <p>{chapter?.summary ?? frontmatter.description}</p>
          <p class="guide-version">One Place Later · {frontmatter.version ?? 'v2.0'}</p>
        </div>
      </div>
    </header>

    {chapter ? (
      <>
        <details class="guide-mobile-nav">
          <summary>
            <span>Chapter {chapterIndex + 1} of {guideChapters.length}</span>
            <strong>Move through this chapter</strong>
          </summary>
          <nav aria-label={`${chapter.title} sections`}>
            <ol>
              {chapter.sections.map((section) => (
                <li><a href={`#${section.id}`}><span>{String(section.number).padStart(2, '0')}</span>{section.title}</a></li>
              ))}
            </ol>
          </nav>
        </details>

        <div class="l-wrapper guide-chapter-shell">
          <aside class="guide-rail">
            <a class="guide-rail__cover" href={`${guideBasePath}/`}>Guide cover <span aria-hidden="true">↖</span></a>
            <nav aria-label="Creative Field Guide chapters">
              <p class="guide-rail__label">Chapter {chapterIndex + 1} of {guideChapters.length}</p>
              <ol class="guide-rail__chapters">
                {guideChapters.map((item, index) => (
                  <li>
                    <a href={guideChapterPath(item)} aria-current={item.slug === chapter.slug ? 'page' : undefined}>
                      <span>{String(index + 1).padStart(2, '0')}</span>{item.shortTitle}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
            <nav aria-label={`${chapter.title} sections`} class="guide-rail__sections">
              <p class="guide-rail__label">In this chapter</p>
              <ol>
                {chapter.sections.map((section) => (
                  <li><a href={`#${section.id}`}><span>{String(section.number).padStart(2, '0')}</span>{section.title}</a></li>
                ))}
              </ol>
            </nav>
          </aside>

          <div class="guide-body guide-body--chapter">
            <slot />

            <nav class="guide-chapter-pagination" aria-label="Adjacent guide chapters">
              {previousChapter ? (
                <a rel="prev" href={guideChapterPath(previousChapter)}>
                  <span>Previous chapter</span>
                  <strong>← {previousChapter.title}</strong>
                </a>
              ) : <span aria-hidden="true"></span>}
              {nextChapter ? (
                <a rel="next" href={guideChapterPath(nextChapter)}>
                  <span>Next chapter</span>
                  <strong>{nextChapter.title} →</strong>
                </a>
              ) : (
                <a href={`${guideBasePath}/`}>
                  <span>Close the guide</span>
                  <strong>Guide cover ↖</strong>
                </a>
              )}
            </nav>
          </div>
        </div>
      </>
    ) : (
      <div class="guide-directory">
        <div class="l-wrapper">
          <section class="guide-directory__intro" aria-labelledby="guide-use-title">
            <p class="guide-label">How to use this guide</p>
            <h2 id="guide-use-title">Read in sequence.<br />Return by chapter.</h2>
            <p>Start with Identity if the system is new. When making a film, move directly to the chapter that answers the decision in front of you.</p>
          </section>

          <ol class="guide-directory__chapters">
            {guideChapters.map((item, index) => (
              <li>
                <article>
                  <header>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <div>
                      <p>Sections {item.sections[0].number}–{item.sections.at(-1)?.number}</p>
                      <h2><a href={guideChapterPath(item)}>{item.title}</a></h2>
                    </div>
                  </header>
                  <p>{item.summary}</p>
                  <ol aria-label={`${item.title} sections`}>
                    {item.sections.map((section) => (
                      <li id={section.id}>
                        <a href={`${guideChapterPath(item)}#${section.id}`}>
                          <span>{String(section.number).padStart(2, '0')}</span>{section.title}
                        </a>
                      </li>
                    ))}
                  </ol>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .guide {
    background: var(--color-bg);
  }

  .guide-header {
    padding-block: var(--space-8);
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
  }

  .guide-header__grid {
    display: grid;
    gap: var(--space-7);
  }

  .guide-kicker,
  .guide-version,
  .guide-index p {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .guide-kicker {
    margin-bottom: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 70%, transparent);
  }

  h1 {
    max-width: 8ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .guide-introduction {
    display: grid;
    align-content: end;
    gap: var(--space-6);
    max-width: 32rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .guide-version {
    color: var(--color-accent);
  }

  .guide-index {
    border-bottom: var(--border-default);
  }

  .guide-index__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .guide-index p {
    color: var(--color-text-muted);
  }

  .guide-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-index a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration-color: color-mix(in srgb, currentColor 28%, transparent);
    text-underline-offset: 0.2em;
  }

  .guide-index a span {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .guide-index a:hover span,
  .guide-index a:focus-visible span {
    transform: translateX(3px);
  }

  .guide-body {
    padding-block: var(--space-8) var(--space-9);
  }

  .guide-body :global(> h2) {
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: var(--border-default);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .guide-body :global(h2[id]),
  .guide-body :global(.guide-chapter[id]) {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .guide-body :global(> h2:first-child) {
    margin-top: 0;
  }

  .guide-body :global(h3) {
    max-width: 42rem;
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .guide-body :global(h4) {
    max-width: 42rem;
    margin-top: var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .guide-body :global(p),
  .guide-body :global(ul),
  .guide-body :global(ol) {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .guide-body :global(ul),
  .guide-body :global(ol) {
    padding-left: 1.2em;
  }

  .guide-body :global(li + li) {
    margin-top: var(--space-2);
  }

  .guide-body :global(strong) {
    font-weight: 600;
  }

  .guide-body :global(blockquote) {
    max-width: 44rem;
    margin: var(--space-6) 0 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
  }

  .guide-body :global(hr) {
    max-width: 44rem;
    margin: var(--space-8) 0 0;
    border: 0;
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-chapter) {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-chapter:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .guide-body :global(.guide-chapter__header) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .guide-body :global(.guide-chapter__number),
  .guide-body :global(.guide-label) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-chapter__number) {
    padding-top: 0.35rem;
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-chapter__header h2) {
    max-width: 17ch;
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .guide-body :global(.guide-chapter__summary) {
    max-width: 32rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .guide-body :global(.guide-chapter__content) {
    min-width: 0;
  }

  .guide-body :global(.guide-nameplate) {
    padding-block: var(--space-5) var(--space-6);
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-nameplate__wordmark) {
    max-width: none;
    margin-top: var(--space-3);
    font-size: clamp(2.15rem, 9vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .guide-body :global(.guide-nameplate__wordmark span) {
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-declaration) {
    padding-block: var(--space-5) var(--space-6);
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-declaration > p:nth-child(2)) {
    max-width: 24ch;
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .guide-body :global(.guide-declaration__support) {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .guide-body :global(.guide-declaration__support p) {
    margin: 0;
    line-height: 1.5;
  }

  .guide-body :global(.guide-life-route) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-life-route li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .guide-body :global(.guide-life-route li::before) {
    position: absolute;
    top: 0.5em;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .guide-body :global(.guide-perspective-grid) {
    display: grid;
    border-bottom: var(--border-default);
  }

  .guide-body :global(.guide-perspective-grid > div) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-perspective-grid > div + div) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-position-list) {
    display: grid;
    gap: var(--space-2);
    max-width: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-position-list li) {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding-bottom: var(--space-2);
    border-bottom: var(--border-default);
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .guide-body :global(.guide-position-list li::before) {
    color: var(--color-accent-strong);
    content: 'Not';
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-perspective-grid__statement p:nth-child(2)) {
    max-width: 16ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-block) {
    padding-block: var(--space-7);
  }

  .guide-body :global(.guide-block h3),
  .guide-body :global(.guide-meaning h3) {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-lede) {
    max-width: 32ch;
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .guide-body :global(.guide-copy) {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .guide-body :global(.guide-copy p) {
    margin: 0;
  }

  .guide-body :global(.guide-principles) {
    display: grid;
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-principle) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-principle + .guide-principle) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-principle p) {
    margin-top: var(--space-4);
    line-height: 1.55;
  }

  .guide-body :global(.guide-principle .guide-label) {
    margin-top: 0;
  }

  .guide-body :global(.guide-principle__statement) {
    max-width: 18ch;
    color: var(--color-text);
    font-size: var(--text-xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .guide-body :global(.guide-principle blockquote) {
    max-width: 24ch;
    margin-top: var(--space-4);
    padding: 0;
    border: 0;
    color: var(--color-text);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-meaning) {
    display: grid;
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-contexts) {
    display: grid;
  }

  .guide-body :global(.guide-modes) {
    display: grid;
    border-block: var(--border-default);
  }

  .guide-body :global(.guide-mode) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-mode + .guide-mode) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-mode h3) {
    max-width: none;
    margin: var(--space-2) 0 0;
    color: var(--color-accent-strong);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .guide-body :global(.guide-mode__thesis) {
    max-width: 18ch;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-mode__copy) {
    max-width: 31rem;
    margin-top: var(--space-5);
    line-height: 1.55;
  }

  .guide-body :global(.guide-mode .guide-label) {
    margin-top: var(--space-6);
  }

  .guide-body :global(.guide-mode__signal) {
    max-width: 24ch;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .guide-body :global(.guide-context) {
    padding-block: var(--space-6);
    border-bottom: var(--border-default);
  }

  .guide-body :global(.guide-context__place) {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .guide-body :global(.guide-context h3) {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .guide-body :global(.guide-observation-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-observation-list li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .guide-body :global(.guide-observation-list li::before) {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .guide-body :global(.guide-meaning__column) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-meaning__column + .guide-meaning__column) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-place-list),
  .guide-body :global(.guide-state-list) {
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-place-list) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
  }

  .guide-body :global(.guide-place-list li) {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    line-height: 1.35;
  }

  .guide-body :global(.guide-place-list li::before) {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent-strong);
    content: '';
  }

  .guide-body :global(.guide-state-list) {
    display: grid;
    gap: var(--space-2);
  }

  .guide-body :global(.guide-state-list li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
    padding-bottom: var(--space-2);
    border-bottom: var(--border-default);
    line-height: 1.35;
  }

  .guide-body :global(.guide-state-list li:last-child) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .guide-body :global(.guide-state-list li > span:first-child) {
    color: var(--color-text-muted);
  }

  .guide-body :global(.guide-state-list li > span:nth-child(2)) {
    color: var(--color-accent-strong);
  }

  .guide-body :global(.guide-state-list strong) {
    font-weight: 500;
  }

  .guide-body :global(.guide-route-examples) {
    border-bottom: var(--border-default);
  }

  .guide-body :global(.guide-route-example) {
    padding-block: var(--space-6);
  }

  .guide-body :global(.guide-route-example + .guide-route-example) {
    border-top: var(--border-default);
  }

  .guide-body :global(.guide-route) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    max-width: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .guide-body :global(.guide-route li) {
    display: inline-flex;
    align-items: center;
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  .guide-body :global(.guide-route li:not(:first-child)::before) {
    margin-inline: var(--space-2);
    color: var(--color-accent-strong);
    content: '→';
    font-weight: 400;
  }

  .guide-body :global(.guide-declaration--rule > p:nth-child(2)) {
    max-width: 22ch;
  }

  .guide-body :global(.guide-declaration--rule > p:nth-child(2) span) {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .guide-body :global(.guide-declaration--directing > p:nth-child(2)),
  .guide-body :global(.guide-declaration--change > p:nth-child(2)) {
    max-width: 24ch;
  }

  .guide-body :global(.guide-declaration--directing > p:nth-child(2) span),
  .guide-body :global(.guide-declaration--change > p:nth-child(2) span) {
