---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    version?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  robots="noindex, nofollow"
>
  <article class="guide">
    <header class="guide-header">
      <div class="l-wrapper guide-header__grid">
        <div>
          <p class="guide-kicker">Internal creative reference</p>
          <h1>Creative<br />Field Guide</h1>
        </div>

        <div class="guide-introduction">
          <p>{frontmatter.description}</p>
          <p class="guide-version">One Place Later · {frontmatter.version ?? 'v2.0'}</p>
        </div>
      </div>
    </header>

    <nav class="guide-index" aria-label="Creative field guide sections">
      <div class="l-wrapper guide-index__inner">
        <p>Move through the guide</p>
        <ol>
          <li><a href="#1-channel-identity">Identity <span aria-hidden="true">→</span></a></li>
          <li><a href="#7-the-fundamental-story-rule">Story <span aria-hidden="true">→</span></a></li>
          <li><a href="#14-core-visual-grammar">Filming <span aria-hidden="true">→</span></a></li>
          <li><a href="#19-sound-philosophy">Sound <span aria-hidden="true">→</span></a></li>
          <li><a href="#28-editing-rhythm">Editing <span aria-hidden="true">→</span></a></li>
          <li><a href="#44-titles">Publishing <span aria-hidden="true">→</span></a></li>
          <li><a href="#56-the-one-place-later-working-brief">Working brief <span aria-hidden="true">→</span></a></li>
        </ol>
      </div>
    </nav>

    <div class="l-wrapper guide-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .guide {
    background: var(--color-bg);
  }

  .guide-header {
    padding-block: var(--space-8);
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
  }

  .guide-header__grid {
    display: grid;
    gap: var(--space-7);
  }

  .guide-kicker,
  .guide-version,
  .guide-index p {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .guide-kicker {
    margin-bottom: var(--space-5);
    color: color-mix(in srgb, var(--color-text-on-dark) 70%, transparent);
  }

  h1 {
    max-width: 8ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .guide-introduction {
    display: grid;
    align-content: end;
    gap: var(--space-6);
    max-width: 32rem;
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .guide-version {
    color: var(--color-accent);
  }

  .guide-index {
    border-bottom: var(--border-default);
  }

  .guide-index__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .guide-index p {
    color: var(--color-text-muted);
  }

  .guide-index ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-index a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration-color: color-mix(in srgb, currentColor 28%, transparent);
    text-underline-offset: 0.2em;
  }

  .guide-index a span {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .guide-index a:hover span,
  .guide-index a:focus-visible span {
    transform: translateX(3px);
  }

  .guide-body {
    padding-block: var(--space-8) var(--space-9);
  }

  .guide-body :global(> h2) {
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: var(--border-default);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .guide-body :global(> h2:first-child) {
    margin-top: 0;
  }

  .guide-body :global(h3) {
    max-width: 42rem;
    margin-top: var(--space-7);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .guide-body :global(h4) {
    max-width: 42rem;
    margin-top: var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .guide-body :global(p),
  .guide-body :global(ul),
  .guide-body :global(ol) {
    max-width: 44rem;
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .guide-body :global(ul),
  .guide-body :global(ol) {
    padding-left: 1.2em;
  }

  .guide-body :global(li + li) {
    margin-top: var(--space-2);
  }

  .guide-body :global(strong) {
    font-weight: 600;
  }

  .guide-body :global(blockquote) {
    max-width: 44rem;
    margin: var(--space-6) 0 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
  }

  .guide-body :global(hr) {
    max-width: 44rem;
    margin: var(--space-8) 0 0;
    border: 0;
    border-top: var(--border-default);
  }

  @media (min-width: 48rem) {
    .guide-header__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      align-items: end;
    }

    .guide-index__inner {
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
      align-items: baseline;
    }

    .guide-body :global(> h2) {
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
      column-gap: var(--space-7);
    }

    .guide-body :global(> h2),
    .guide-body :global(> h3),
    .guide-body :global(> h4),
    .guide-body :global(> p),
    .guide-body :global(> ul),
    .guide-body :global(> ol),
    .guide-body :global(> blockquote),
    .guide-body :global(> hr) {
      margin-left: 25%;
    }

    .guide-body :global(> h2) {
      margin-left: 0;
    }
  }
</style>
