---
import BrandMark from './BrandMark.astro';

const youtubeUrl = 'https://www.youtube.com/@OnePlaceLater';
const instagramUrl = 'https://www.instagram.com/oneplacelater';
---

<footer class="site-footer" data-surface="dark">
  <div class="l-wrapper inner">
    <div class="brand-block">
      <BrandMark variant="display" tone="carbon" />
      <p class="brand-line">Ordinary life, noticed in motion.</p>
    </div>

    <div class="footer-navigation">
      <p>Seoul, South Korea</p>
      <nav aria-label="One Place Later destinations">
        <ul>
          <li>
            <a href={youtubeUrl} target="_blank" rel="me noopener">
              YouTube <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a href={instagramUrl} target="_blank" rel="me noopener">
              Instagram <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="copyright">© 2026</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
  }

  .inner {
    display: grid;
    gap: var(--space-7);
  }

  .brand-line,
  .footer-navigation {
    color: color-mix(in srgb, var(--color-text-on-dark) 74%, transparent);
    font-size: var(--text-sm);
  }

  .brand-line {
    margin-top: var(--space-3);
  }

  .footer-navigation {
    display: grid;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-text-on-dark);
    text-decoration: none;
  }

  a span {
    color: var(--color-accent);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  a:hover span,
  a:focus-visible span {
    transform: translate(2px, -2px);
  }

  .copyright {
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--color-text-on-dark) 20%, transparent);
    color: color-mix(in srgb, var(--color-text-on-dark) 60%, transparent);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .footer-navigation {
      justify-items: end;
      text-align: right;
    }

    .copyright {
      grid-column: 1 / -1;
    }
  }
</style>
