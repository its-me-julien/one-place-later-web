---
interface Props {
  variant?: 'compact' | 'display';
  tone?: 'paper' | 'carbon';
}

const { variant = 'compact', tone = 'paper' } = Astro.props;
---

<span class:list={['brand-mark', `brand-mark--${variant}`, `brand-mark--${tone}`]}>
  <span class="brand-mark__name">One Place <span class="brand-mark__later">Later</span></span>
  <svg
    class="brand-mark__route"
    viewBox="0 0 74 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <circle class="brand-mark__origin" cx="6" cy="25" r="3.25"></circle>
    <path
      class="brand-mark__path"
      d="M14 25h12.5c7 0 8-13 16-13H59m-8.5-8.5L59 12l-8.5 8.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="3.25"
    ></path>
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand-mark__later {
    letter-spacing: -0.045em;
  }

  .brand-mark__route {
    display: block;
    width: 2.9rem;
    height: auto;
    overflow: visible;
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .brand-mark__origin {
    fill: var(--color-accent-strong);
  }

  .brand-mark__path {
    stroke: var(--color-text-muted);
    transition:
      opacity var(--motion-base) var(--ease-standard),
      stroke var(--motion-base) var(--ease-standard);
  }

  .brand-mark--display {
    gap: 0.6rem;
    font-size: var(--text-xl);
  }

  .brand-mark--display .brand-mark__route {
    width: 3.75rem;
  }

  .brand-mark--carbon .brand-mark__origin {
    fill: var(--color-accent);
  }

  .brand-mark--carbon .brand-mark__path {
    stroke: var(--color-text-on-dark);
    opacity: 0.82;
  }

  :global(.brand-lockup:hover) .brand-mark__route,
  :global(.brand-lockup:focus-visible) .brand-mark__route {
    transform: translateX(3px);
  }

  :global(.brand-lockup:hover) .brand-mark__path,
  :global(.brand-lockup:focus-visible) .brand-mark__path {
    stroke: var(--color-text);
    opacity: 1;
  }

  :global(.brand-lockup:hover) .brand-mark--carbon .brand-mark__path,
  :global(.brand-lockup:focus-visible) .brand-mark--carbon .brand-mark__path {
    stroke: var(--color-text-on-dark);
  }

  @media (max-width: 24rem) {
    .brand-mark--compact {
      gap: 0.3rem;
      font-size: var(--text-xs);
    }

    .brand-mark--compact .brand-mark__route {
      width: 2.25rem;
    }

    .brand-mark--display {
      flex-wrap: wrap;
    }

    .brand-mark--display .brand-mark__name {
      max-width: 100%;
      white-space: normal;
    }
  }
</style>
