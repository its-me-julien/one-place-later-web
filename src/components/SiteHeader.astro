---
const youtubeUrl = 'https://www.youtube.com/@OnePlaceLater';
---

<header class="site-header">
  <div class="l-wrapper inner">
    <a class="brand" href="/" aria-label="One Place Later, home">
      <span>One Place Later</span>
      <img class="arrow-mark" src="/one-place-later-arrow.svg" alt="" />
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        <li><a href="#about">About</a></li>
        <li>
          <a href={youtubeUrl} target="_blank" rel="me noopener">
            YouTube <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    height: var(--header-height);
    border-bottom: var(--border-default);
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .arrow-mark {
    width: 2.5rem;
    height: auto;
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .brand:hover .arrow-mark {
    transform: translateX(3px);
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  nav a span {
    color: var(--color-accent-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  nav a:hover span {
    transform: translate(2px, -2px);
  }

  @media (min-width: 40rem) {
    .inner {
      gap: var(--space-5);
    }

    ul {
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }
  }
</style>
