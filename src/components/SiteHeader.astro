---
import BrandMark from './BrandMark.astro';

const youtubeUrl = 'https://www.youtube.com/@OnePlaceLater';

const navigation = [
  { label: 'About', href: '#about', kind: 'section' },
  { label: 'YouTube', href: youtubeUrl, kind: 'channel', external: true },
];
---

<header class="site-header">
  <div class="l-wrapper inner">
    <a class="brand-lockup" href="/" aria-label="One Place Later, home">
      <BrandMark />
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navigation.map(({ label, href, kind, external }) => (
            <li>
              <a
                class:list={['nav-link', `nav-link--${kind}`]}
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'me noopener' : undefined}
              >
                {label}
                {external && <span class="external-arrow" aria-hidden="true">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    height: var(--header-height);
    border-bottom: var(--border-default);
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand-lockup {
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding-inline: 0.625rem;
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link--section {
    position: relative;
  }

  .nav-link--section::after {
    position: absolute;
    right: 0.625rem;
    bottom: 0.6rem;
    left: 0.625rem;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: 0;
    transform: scaleX(0.35);
    transform-origin: left center;
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
  }

  .nav-link--section:hover::after,
  .nav-link--section:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-link--channel {
    min-width: 6.5rem;
    padding-inline: 0.875rem;
    color: var(--color-text-on-dark);
    background: var(--color-surface-dark);
    border-radius: var(--radius-sm);
  }

  .external-arrow {
    color: var(--color-bg);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .nav-link--channel:hover,
  .nav-link--channel:focus-visible {
    background: var(--color-accent-strong);
  }

  .nav-link--channel:hover .external-arrow,
  .nav-link--channel:focus-visible .external-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 24rem) {
    .inner {
      gap: var(--space-1);
    }

    .brand-lockup {
      font-size: var(--text-xs);
    }

    .nav-list {
      gap: 0;
    }

    .nav-link {
      min-height: 2.5rem;
      padding-inline: 0.45rem;
      font-size: var(--text-xs);
    }

    .nav-link--section::after {
      right: 0.45rem;
      bottom: 0.5rem;
      left: 0.45rem;
    }

    .nav-link--channel {
      min-width: 0;
      padding-inline: 0.6rem;
    }
  }

  @media (min-width: 40rem) {
    .inner {
      gap: var(--space-5);
    }

    .nav-list {
      gap: var(--space-3);
    }

    .nav-link {
      padding-inline: 0.75rem;
    }

    .nav-link--channel {
      min-width: 7.25rem;
    }
  }
</style>
